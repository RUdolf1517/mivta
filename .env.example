# Required: Telegram Bot token from @BotFather (make sure /setinline is enabled)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Translator provider: google | mymemory | groq | gemini | mistral | openrouter | openai | deepl | libretranslate
# Out of the box, `google` automatically falls back to keyless `mymemory` on 429 / timeout.
TRANSLATOR_PROVIDER=google

# Or define a full multi-API failover chain (each provider can have its own <PROVIDER>_API_KEY):
# TRANSLATOR_CHAIN=groq,gemini,mistral,google,mymemory
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# MYMEMORY_EMAIL=

# Primary provider credentials & endpoint (or use <PROVIDER>_API_KEY / _MODEL / _API_URL)
TRANSLATOR_API_KEY=
TRANSLATOR_API_URL=
TRANSLATOR_MODEL=
TRANSLATOR_TIMEOUT=5.0
TRANSLATOR_COOLDOWN=30.0

# Optional explicit fallback provider(s) (leave empty for automatic google->mymemory; `none` to disable)
TRANSLATOR_FALLBACK_PROVIDER=
TRANSLATOR_FALLBACK_API_KEY=
TRANSLATOR_FALLBACK_API_URL=
TRANSLATOR_FALLBACK_MODEL=

# Optional comma-separated mini-glossary of names/terms to keep untranslated
TRANSLATOR_GLOSSARY=

# Default user preferences, bidirectional auto-swap & Inline Mode options
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=en
DEFAULT_SWAP_LANG=
DEFAULT_STYLE=neutral
DEFAULT_UI_LANG=ru
INLINE_EXTRA_LANGS=
INLINE_STYLE_VARIANTS=true
INLINE_DEBOUNCE_MS=180

# Optional Webhook mode (leave WEBHOOK_URL empty to run Long Polling out of the box)
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# Storage & operational limits
DATABASE_PATH=data/mivta.db
MAX_TEXT_LENGTH=500
CACHE_TTL=300
CACHE_MAX_SIZE=512
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=15
MAX_CONCURRENT_TRANSLATIONS=20
LOG_LEVEL=INFO
