# Required: Telegram Bot token from @BotFather (make sure /setinline is enabled)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Translator provider: google | openai | groq | gemini | openrouter | deepl | libretranslate
# - openai / groq / gemini / openrouter: LLM presets with neutral / casual / formal styles
# - deepl: DeepL API v2 (native neutral / casual / formal formality)
# - libretranslate: Self-hosted or public LibreTranslate API
# - google: Keyless Google Translate endpoint (fast zero-key default; ignores style)
TRANSLATOR_PROVIDER=google

# Provider credentials & endpoint (required for openai, groq, gemini, openrouter, deepl)
TRANSLATOR_API_KEY=
TRANSLATOR_API_URL=
TRANSLATOR_MODEL=
TRANSLATOR_TIMEOUT=5.0

# Optional fallback chain on timeout / 429 / upstream errors (e.g. google or libretranslate,google)
TRANSLATOR_FALLBACK_PROVIDER=
TRANSLATOR_FALLBACK_API_KEY=
TRANSLATOR_FALLBACK_API_URL=
TRANSLATOR_FALLBACK_MODEL=

# Optional comma-separated mini-glossary of names/terms to keep untranslated
TRANSLATOR_GLOSSARY=

# Default user preferences, bidirectional auto-swap & Inline Mode options
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=en
DEFAULT_SWAP_LANG=
DEFAULT_STYLE=neutral
DEFAULT_UI_LANG=ru
INLINE_EXTRA_LANGS=
INLINE_STYLE_VARIANTS=true
INLINE_DEBOUNCE_MS=180

# Optional Webhook mode (leave WEBHOOK_URL empty to run Long Polling out of the box)
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# Storage & operational limits
DATABASE_PATH=data/mivta.db
MAX_TEXT_LENGTH=500
CACHE_TTL=300
CACHE_MAX_SIZE=512
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=15
MAX_CONCURRENT_TRANSLATIONS=20
LOG_LEVEL=INFO
