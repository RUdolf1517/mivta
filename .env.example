# Required: Telegram Bot token from @BotFather (make sure /setinline is enabled)
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Translator provider: google | openai | deepl | libretranslate
# - openai: OpenAI-compatible API (supports neutral / casual / formal styles)
# - deepl: DeepL API v2 (supports neutral / casual / formal formality)
# - libretranslate: Self-hosted or public LibreTranslate API
# - google: Keyless Google Translate endpoint (fast zero-key default; ignores style)
TRANSLATOR_PROVIDER=google

# Provider credentials & endpoint (required for openai and deepl)
TRANSLATOR_API_KEY=
TRANSLATOR_API_URL=
TRANSLATOR_MODEL=gpt-4o-mini
TRANSLATOR_TIMEOUT=5.0

# Default user preferences
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=en
DEFAULT_STYLE=neutral

# Storage & operational limits
DATABASE_PATH=data/mivta.db
MAX_TEXT_LENGTH=500
CACHE_TTL=300
CACHE_MAX_SIZE=512
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=15
MAX_CONCURRENT_TRANSLATIONS=20
LOG_LEVEL=INFO
